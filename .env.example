# Server Configuration
PORT=5000

# MongoDB Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/<database_name>?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here

# Cloudinary Configuration (Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Render / Deployment Keep-Alive URL (Optional)
# Note: On Render, RENDER_EXTERNAL_URL is set automatically.
# You can also manually provide APP_URL for testing or other hosts:
APP_URL=https://your-app-name.onrender.com
